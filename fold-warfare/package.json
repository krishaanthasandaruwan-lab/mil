{
  "name": "fold-warfare",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "python3 tools/process_assets.py",
    "prompts": "python3 tools/build_prompt_pack.py",
    "privacy": "node tools/build_privacy.cjs",
    "audio": "python3 tools/process_audio.py"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.4",
    "foldwarfare-native": "file:packages/foldwarfare-native",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "docx": "^9.5.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "private": true
}
